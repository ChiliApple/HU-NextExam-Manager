<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HU-NextExam-Manager v2.0.0"
        Height="720" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">
    <Window.Resources>
        <SolidColorBrush x:Key="BgMain"    Color="#1E1E1E"/>
        <SolidColorBrush x:Key="BgPanel"   Color="#252526"/>
        <SolidColorBrush x:Key="BgCtrl"    Color="#2D2D30"/>
        <SolidColorBrush x:Key="FgMain"    Color="#E0E0E0"/>
        <SolidColorBrush x:Key="FgDim"     Color="#9A9A9A"/>
        <SolidColorBrush x:Key="Accent"    Color="#0A84FF"/>
        <SolidColorBrush x:Key="BorderCol" Color="#3F3F46"/>
        <SolidColorBrush x:Key="OkCol"     Color="#4CAF50"/>
        <SolidColorBrush x:Key="WarnCol"   Color="#FF9800"/>
        <SolidColorBrush x:Key="ErrCol"    Color="#F44336"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource FgMain}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource FgMain}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource BgCtrl}"/>
            <Setter Property="Foreground" Value="{StaticResource FgMain}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderCol}"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource BgCtrl}"/>
            <Setter Property="Foreground" Value="{StaticResource FgMain}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderCol}"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="MainBorder" Grid.ColumnSpan="2"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"/>
                            <ContentPresenter Grid.Column="0"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="6,3,0,3" VerticalAlignment="Center"
                                              IsHitTestVisible="False"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                            <ToggleButton Grid.Column="1"
                                          Background="Transparent" BorderThickness="0"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent">
                                            <Path Data="M 0 0 L 4 4 L 8 0 Z" Fill="#E0E0E0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False">
                                <Border Background="#2D2D30" BorderBrush="#3F3F46" BorderThickness="1"
                                        MinWidth="{TemplateBinding ActualWidth}" MaxHeight="300">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="#0A84FF"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="#0A84FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="Padding" Value="6,3"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#094771"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#094771"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BgCtrl}"/>
            <Setter Property="Foreground" Value="{StaticResource FgMain}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderCol}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#3F3F46"/>
                                <Setter TargetName="B" Property="BorderBrush" Value="#0A84FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#0A84FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#6A6A6A"/>
                                <Setter TargetName="B" Property="Background" Value="#252526"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="B" Property="BorderBrush" Value="#0A84FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{StaticResource BgCtrl}"/>
            <Setter Property="Foreground" Value="{StaticResource FgMain}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderCol}"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="{StaticResource BgPanel}"/>
            <Setter Property="Foreground" Value="{StaticResource FgMain}"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Border" Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource BorderCol}" BorderThickness="1,1,1,0"
                                Margin="2,0,0,-1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="ContentSite" ContentSource="Header"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#1E1E1E"/>
                                <Setter Property="Foreground" Value="#E0E0E0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#3F3F46"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ListBoxItem (fuer lstTasks) - dunkles Selection-Highlight -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource FgMain}"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="B" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#094771"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#3F3F46"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ListViewItem (fuer lstMSITasks + lstGPOTasks) - ControlTemplate mit GridViewRowPresenter -->
        <Style TargetType="ListViewItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource FgMain}"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="B" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <GridViewRowPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#094771"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#3F3F46"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- GridViewColumnHeader - dunkel mit ControlTemplate -->
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="{StaticResource BgPanel}"/>
            <Setter Property="Foreground" Value="{StaticResource FgMain}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderCol}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Border x:Name="H" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="H" Property="Background" Value="#3F3F46"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="H" Property="Background" Value="#094771"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{StaticResource BgMain}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderCol}"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="{StaticResource FgMain}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderCol}"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="4"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource FgMain}"/>
            <Setter Property="Margin" Value="4"/>
        </Style>
    </Window.Resources>

    <Grid>
        <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="{StaticResource BgPanel}" Padding="10,6" BorderBrush="{StaticResource BorderCol}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="HU-NextExam-Manager" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="lblVersion" Text="" Foreground="{StaticResource FgDim}" FontSize="13" Margin="6,2,0,0" VerticalAlignment="Center"/>
                    <Image x:Name="imgAppLogo" Height="32" Width="32" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="btnUpdate" Content="Aktuell" IsEnabled="False" Width="110"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Statusbar -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource BgPanel}" Padding="10,4" BorderBrush="{StaticResource BorderCol}" BorderThickness="0,1,0,0">
            <TextBlock x:Name="lblStatus" Text="Bereit" Foreground="{StaticResource FgDim}"/>
        </Border>

        <!-- Main TabControl -->
        <TabControl x:Name="tabMain" Margin="4">
            <TabItem Header="Dashboard">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="3*" MinHeight="150"/>
                        <RowDefinition Height="1*" MinHeight="80"/>
                    </Grid.RowDefinitions>

                    <GroupBox Header="Tool" Grid.Row="0">
                        <StackPanel Margin="6">
                            <TextBlock x:Name="lblDashToolVer"    Text="Tool-Version: ..."/>
                            <TextBlock x:Name="lblDashConfigPath" Text="Config: ..."/>
                            <TextBlock x:Name="lblDashLogPath"    Text="Log:    ..."/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Next-Exam Release (GitHub)" Grid.Row="1">
                        <Grid Margin="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="lblDashRelTag"     Text="Tag:        -"/>
                                <TextBlock x:Name="lblDashRelStudent" Text="Student:    -"/>
                                <TextBlock x:Name="lblDashRelTeacher" Text="Teacher:    -"/>
                            </StackPanel>
                            <Button x:Name="btnDashRefresh" Grid.Column="1" Content="aktualisieren" Width="170" VerticalAlignment="Top"/>
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="MDM Status (Intune)" Grid.Row="2">
                        <Grid Margin="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                <TextBlock x:Name="lblDashMDMTenant" Text="Tenant: nicht konfiguriert" Foreground="#9A9A9A"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,20,0">
                                <TextBlock Text="Student" FontWeight="Bold" Foreground="{StaticResource FgMain}" FontSize="11"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="lblDashMDMStudentVer" Text="Intune: -" Foreground="#E0E0E0" Margin="0,0,12,0"/>
                                    <TextBlock x:Name="lblDashMDMStudentGH"  Text="GitHub: -" Foreground="#E0E0E0"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock x:Name="lblDashMDMStudentIcon" Text="&#x2753;" FontSize="16" HorizontalAlignment="Center" ToolTip="Nicht geprueft"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3" Margin="0,0,20,0">
                                <TextBlock Text="Teacher" FontWeight="Bold" Foreground="{StaticResource FgMain}" FontSize="11"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="lblDashMDMTeacherVer" Text="Intune: -" Foreground="#E0E0E0" Margin="0,0,12,0"/>
                                    <TextBlock x:Name="lblDashMDMTeacherGH"  Text="GitHub: -" Foreground="#E0E0E0"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                <TextBlock x:Name="lblDashMDMTeacherIcon" Text="&#x2753;" FontSize="16" HorizontalAlignment="Center" ToolTip="Nicht geprueft"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>


                    <GroupBox Header="Clients (Status aus Status-Share der Tasks)" Grid.Row="3">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Label Content="Task:" Grid.Column="0" VerticalAlignment="Center"/>
                                <ComboBox x:Name="cmbClientTask" Grid.Column="1" Width="220" VerticalAlignment="Center" />
                                <TextBlock x:Name="lblClientShare" Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#9A9A9A" TextTrimming="CharacterEllipsis"/>
                                <Button x:Name="btnClientRefresh" Grid.Column="3" Content="Aktualisieren" Width="130"/>
                            </Grid>
                            <ListView x:Name="lstClients" Grid.Row="1" Background="#2D2D30" Foreground="#E0E0E0" BorderBrush="#3F3F46">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Computer"    Width="160" DisplayMemberBinding="{Binding ComputerName}"/>
                                        <GridViewColumn Header="Rolle"       Width="80"  DisplayMemberBinding="{Binding Role}"/>
                                        <GridViewColumn Header="Installiert" Width="120" DisplayMemberBinding="{Binding Installed}"/>
                                        <GridViewColumn Header="Ziel"        Width="120" DisplayMemberBinding="{Binding Target}"/>
                                        <GridViewColumn Header="Status"      Width="100" DisplayMemberBinding="{Binding LastAction}"/>
                                        <GridViewColumn Header="Letzter Check" Width="160" DisplayMemberBinding="{Binding LastCheck}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="Tasks - Deploy + GPO Status" Grid.Row="4">
                        <ListView x:Name="lstDashTasks" Background="#2D2D30" Foreground="#E0E0E0" BorderBrush="#3F3F46">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Task"          Width="150" DisplayMemberBinding="{Binding DisplayName}"/>
                                    <GridViewColumn Header="Student-MSI"   Width="140" DisplayMemberBinding="{Binding StudentMSI}"/>
                                    <GridViewColumn Header="Teacher-MSI"   Width="140" DisplayMemberBinding="{Binding TeacherMSI}"/>
                                    <GridViewColumn Header="MSI-Status"    Width="120" DisplayMemberBinding="{Binding MSIStatus}"/>
                                    <GridViewColumn Header="Install-GPOs"  Width="140" DisplayMemberBinding="{Binding InstallGPOStatus}"/>
                                    <GridViewColumn Header="FW-GPOs"       Width="130" DisplayMemberBinding="{Binding FWGPOStatus}"/>
                                    <GridViewColumn Header="Gesamt"        Width="100" DisplayMemberBinding="{Binding Overall}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="MSI Pull">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Release-Info Panel -->
                    <GroupBox Header="Next-Exam Release (Bildungsportal/next-exam)" Grid.Row="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Vertical" Margin="4">
                                <TextBlock x:Name="lblReleaseVersion" Text="Tag:       (lade...)"/>
                                <TextBlock x:Name="lblReleaseDate"    Text="Stand:     -"/>
                                <TextBlock x:Name="lblReleaseStudent" Text="Student:   -"/>
                                <TextBlock x:Name="lblReleaseTeacher" Text="Teacher:   -"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                <Button x:Name="btnReleaseRefresh"  Content="Release abfragen" Width="150"/>
                                <Button x:Name="btnReleaseChangelog" Content="Changelog..."    Width="150" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <!-- Tasks-Status -->
                    <GroupBox Header="Tasks (Doppelklick = nur diesen deployen)" Grid.Row="1">
                        <ListView x:Name="lstMSITasks" SelectionMode="Extended"
                                  Background="#2D2D30" Foreground="#E0E0E0" BorderBrush="#3F3F46">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Task"           Width="180" DisplayMemberBinding="{Binding DisplayName}"/>
                                    <GridViewColumn Header="Student lokal"  Width="140" DisplayMemberBinding="{Binding StudentVersion}"/>
                                    <GridViewColumn Header="Teacher lokal"  Width="140" DisplayMemberBinding="{Binding TeacherVersion}"/>
                                    <GridViewColumn Header="Status"         Width="150" DisplayMemberBinding="{Binding Status}"/>
                                    <GridViewColumn Header="Student-Share"  Width="250" DisplayMemberBinding="{Binding StudentSharePath}"/>
                                    <GridViewColumn Header="Teacher-Share"  Width="250" DisplayMemberBinding="{Binding TeacherSharePath}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </GroupBox>

                    <!-- Aktionen -->
                    <Grid Grid.Row="2" Margin="4,6,4,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <CheckBox x:Name="chkAutoPull" Content="Auto-Pull taeglich um" VerticalAlignment="Center"/>
                                <TextBox  x:Name="txtAutoPullTime" Width="60" Text="03:00" VerticalAlignment="Center" Margin="6,0"/>
                                <RadioButton x:Name="rbAutoPullSystem" GroupName="AutoPullPrincipal" Content="SYSTEM" IsChecked="True" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#E0E0E0"
                                             ToolTip="Laeuft auch ohne angemeldeten User. Erfordert: (1) Tool als Admin gestartet, (2) Machine-Account (COMPUTER$) hat Lese-/Schreibrechte auf alle Shares (z.B. via Domaenen-Computer-Gruppe in ACL), (3) Internet-Zugriff via System-Proxy."/>
                                <RadioButton x:Name="rbAutoPullUser"   GroupName="AutoPullPrincipal" Content="User" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="#E0E0E0"
                                             ToolTip="Laeuft nur wenn dieser User angemeldet ist. Kein Admin noetig. Verpasste Zeiten werden beim naechsten Login nachgeholt (StartWhenAvailable)."/>
                                <TextBlock x:Name="lblAutoPullStatus" Text="(nicht registriert)" Foreground="#9A9A9A" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>
                            <TextBlock Foreground="#888" FontSize="11" Margin="22,2,0,0" TextWrapping="Wrap">
                                SYSTEM: Tool als Admin starten + Share-ACL fuer Machine-Account (Domaenen-Computer) noetig.
                                User: nur bei Anmeldung, Nachhol-Lauf via StartWhenAvailable.
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="btnRefreshStatus"   Content="Status aktualisieren" Width="160"/>
                            <Button x:Name="btnDeploySelected"  Content="Auswahl aktualisieren" Width="170" Background="#0A84FF" Foreground="White"/>
                            <Button x:Name="btnDeployAll"       Content="Alle aktualisieren"   Width="160"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="MDM Pull">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Row 0: Header + Tenant-Auswahl -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="MDM Pull (Intune)" FontSize="18" FontWeight="Bold" Foreground="{StaticResource FgMain}" Grid.Column="0" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                            <Label Content="Tenant:" Foreground="#E0E0E0" VerticalAlignment="Center"/>
                            <ComboBox x:Name="cmbMDMTenant" Width="220" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Grid.Column="3" VerticalAlignment="Center">
                            <Button x:Name="btnMDMOpenDocs" Content="Docs" Width="60" Margin="0,0,6,0" ToolTip="Docs\MDM-Setup.md oeffnen"/>
                            <Button x:Name="btnMDMRefreshStatus" Content="Status pruefen" Width="120"/>
                        </StackPanel>
                    </Grid>

                    <!-- Row 1: Auth-Modus -->
                    <GroupBox Header="Authentifizierung" Grid.Row="1" Margin="0,0,0,8">
                        <Grid Margin="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <RadioButton x:Name="rbMDMAuthAppToken" GroupName="MDMAuth" Content="App-Credentials (automatisch)" IsChecked="True" Foreground="#E0E0E0" Margin="0,2"/>
                                <RadioButton x:Name="rbMDMAuthInteractive" GroupName="MDMAuth" Content="Admin-Anmeldung (diese Session)" Foreground="#E0E0E0" Margin="0,2"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="lblMDMAuthStatus" Text="Kein Token" Foreground="#9A9A9A" FontSize="12"/>
                                <TextBlock x:Name="lblMDMDeviceCode" Text="" Foreground="#FFD700" FontFamily="Consolas" FontSize="14" FontWeight="Bold" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <Button x:Name="btnMDMConnect" Content="Verbinden" Width="110" Margin="0,0,0,4"/>
                                <Button x:Name="btnMDMSetupApp" Content="App einrichten" Width="110" FontSize="11" Foreground="#9A9A9A" ToolTip="App-Registration im Tenant anlegen + Credentials speichern"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <!-- Row 2: App-Status + Versions-Info -->
                    <GroupBox Header="App-Status" Grid.Row="2" Margin="0,0,0,8">
                        <StackPanel Margin="6">
                            <!-- Versions-Zeile: Student | Teacher | Overall -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Student" FontWeight="Bold" Foreground="{StaticResource FgMain}" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="lblMDMStudentIntune" Text="Intune: -" Foreground="#E0E0E0"/>
                                    <TextBlock x:Name="lblMDMStudentGitHub" Text="GitHub: -" Foreground="#E0E0E0"/>
                                    <TextBlock x:Name="lblMDMStudentStatus" Text="" Foreground="#9A9A9A" FontSize="11" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Teacher" FontWeight="Bold" Foreground="{StaticResource FgMain}" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="lblMDMTeacherIntune" Text="Intune: -" Foreground="#E0E0E0"/>
                                    <TextBlock x:Name="lblMDMTeacherGitHub" Text="GitHub: -" Foreground="#E0E0E0"/>
                                    <TextBlock x:Name="lblMDMTeacherStatus" Text="" Foreground="#9A9A9A" FontSize="11" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock x:Name="lblMDMOverallStatus" Text="Nicht geprueft" Foreground="#888" FontSize="13" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                            <!-- Metadaten-Abweichungen DataGrid (hidden until populated) -->
                            <TextBlock x:Name="lblMDMMetaDiffHeader" Text="" Foreground="#FFD700" FontSize="12" FontWeight="Bold" Margin="0,8,0,4" Visibility="Collapsed"/>
                            <ListView x:Name="lstMDMMetaDiffs" Visibility="Collapsed" MaxHeight="160" Background="#2D2D30" Foreground="#E0E0E0" BorderBrush="#3F3F46" Margin="0,0,0,4" FontSize="12">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="#E0E0E0"/>
                                        <Setter Property="Padding" Value="2,1"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListViewItem">
                                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                                        <GridViewRowPresenter Content="{TemplateBinding Content}" Columns="{TemplateBinding GridView.ColumnCollection}"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#3A3A3C"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#0078D4"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Rolle" Width="70" DisplayMemberBinding="{Binding Role}"/>
                                        <GridViewColumn Header="Feld" Width="120" DisplayMemberBinding="{Binding Field}"/>
                                        <GridViewColumn Header="Intune (IST)" Width="250" DisplayMemberBinding="{Binding Actual}"/>
                                        <GridViewColumn Header="Soll" Width="250" DisplayMemberBinding="{Binding Expected}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </StackPanel>
                    </GroupBox>

                    <!-- Row 3: Gruppen-Zuweisung (kompakt als Expander) -->
                    <Expander Header="Gruppen-Zuweisung (Required)" Grid.Row="3" IsExpanded="False" Foreground="#E0E0E0" Margin="0,0,0,8">
                        <Grid Margin="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,4,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="txtMDMGroupFilter" Grid.Column="0" Background="#3C3C3C" Foreground="#E0E0E0" BorderBrush="#555" Padding="4,2" ToolTip="Gruppenname filtern..."/>
                                <CheckBox x:Name="chkMDMAvailableAll" Grid.Column="1" Content="Verfuegbar fuer alle User" IsChecked="True" Foreground="#E0E0E0" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                <Button x:Name="btnMDMLoadGroups" Grid.Column="2" Content="Gruppen laden" Width="110" Margin="10,0,0,0"/>
                            </Grid>
                            <ListView x:Name="lstMDMGroups" Grid.Row="1" Height="180" Background="#2D2D30" Foreground="#E0E0E0" BorderBrush="#3F3F46" SelectionMode="Multiple">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="#E0E0E0"/>
                                        <Setter Property="Padding" Value="2,1"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListViewItem">
                                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                                        <GridViewRowPresenter Content="{TemplateBinding Content}" Columns="{TemplateBinding GridView.ColumnCollection}"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#3A3A3C"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#0078D4"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Width="30">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding RelativeSource={RelativeSource AncestorType=ListViewItem}, Path=IsSelected}" HorizontalAlignment="Center"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Gruppenname" Width="320" DisplayMemberBinding="{Binding displayName}"/>
                                        <GridViewColumn Header="Typ" Width="120" DisplayMemberBinding="{Binding GroupType}"/>
                                        <GridViewColumn Header="ID" Width="250" DisplayMemberBinding="{Binding id}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Grid>
                    </Expander>

                    <!-- Row 4: App-Metadaten (Expander) -->
                    <Expander Header="App-Metadaten (optional anpassen)" Grid.Row="4" IsExpanded="False" Foreground="#E0E0E0" Margin="0,0,0,8">
                        <Grid Margin="10,6,10,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <!-- Row 0: Publisher + Developer -->
                            <Label Content="Publisher:" Foreground="#CCC" Grid.Row="0" Grid.Column="0"/>
                            <TextBox x:Name="txtMDMPublisher" Grid.Row="0" Grid.Column="1" Background="#3C3C3C" Foreground="#E0E0E0" BorderBrush="#555" Text="Bildungsportal" Margin="0,2"/>
                            <Label Content="Developer:" Foreground="#CCC" Grid.Row="0" Grid.Column="2"/>
                            <TextBox x:Name="txtMDMDeveloper" Grid.Row="0" Grid.Column="3" Background="#3C3C3C" Foreground="#E0E0E0" BorderBrush="#555" Text="Mag. Thomas Michael Weissel" Margin="0,2"/>
                            <!-- Row 1: Description -->
                            <Label Content="Description:" Foreground="#CCC" Grid.Row="1" Grid.Column="0"/>
                            <TextBox x:Name="txtMDMDescription" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Background="#3C3C3C" Foreground="#E0E0E0" BorderBrush="#555" Text="Next-Exam &#x2013; BMB-Pruefungsclient fuer sichere digitale Pruefungen" Margin="0,2" ToolTip="Leer = displayName wird verwendet"/>
                            <!-- Row 2: Information URL -->
                            <Label Content="Info-URL:" Foreground="#CCC" Grid.Row="2" Grid.Column="0"/>
                            <TextBox x:Name="txtMDMInfoUrl" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Background="#3C3C3C" Foreground="#E0E0E0" BorderBrush="#555" Text="https://github.com/Bildungsportal/next-exam" Margin="0,2"/>
                            <!-- Row 3: Install-Cmd -->
                            <Label Content="Install-Cmd:" Foreground="#CCC" Grid.Row="3" Grid.Column="0"/>
                            <TextBox x:Name="txtMDMInstallCmd" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Background="#3C3C3C" Foreground="#E0E0E0" BorderBrush="#555" Text="msiexec /i NextExamStudent.msi /qn" Margin="0,2"/>
                            <!-- Row 4: Uninstall-Cmd -->
                            <Label Content="Uninstall-Cmd:" Foreground="#CCC" Grid.Row="4" Grid.Column="0"/>
                            <TextBox x:Name="txtMDMUninstallCmd" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" Background="#3C3C3C" Foreground="#E0E0E0" BorderBrush="#555" Text="msiexec /x {PRODUCT-CODE} /qn" Margin="0,2"/>
                            <!-- Row 5: Install-Kontext -->
                            <Label Content="Install-Kontext:" Foreground="#CCC" Grid.Row="5" Grid.Column="0"/>
                            <ComboBox x:Name="cmbMDMInstallContext" Grid.Row="5" Grid.Column="1" Width="120" HorizontalAlignment="Left" SelectedIndex="0" Background="#3C3C3C" Foreground="#111">
                                <ComboBoxItem Content="system"/>
                                <ComboBoxItem Content="user"/>
                            </ComboBox>
                            <!-- Row 6: App-Icon -->
                            <Label Content="App-Icon:" Foreground="#CCC" Grid.Row="6" Grid.Column="0" VerticalAlignment="Center"/>
                            <StackPanel Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4">
                                <Image x:Name="imgMDMAppIcon" Width="32" Height="32" Margin="0,0,8,0"/>
                                <TextBlock x:Name="lblMDMIconPath" Text="Assets\icon.png" Foreground="#9A9A9A" VerticalAlignment="Center" FontSize="11"/>
                                <TextBlock x:Name="lblMDMIconStatus" Text="" Foreground="#107C10" VerticalAlignment="Center" FontSize="11" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Expander>

                    <!-- Row 5: Aktions-Buttons + Progress -->
                    <Grid Grid.Row="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <ProgressBar x:Name="prgMDM" Height="18" Minimum="0" Maximum="100" Value="0" Margin="0,0,10,0"/>
                            <TextBlock x:Name="lblMDMProgress" Text="" Foreground="#9A9A9A" FontSize="11" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center">
                            <CheckBox x:Name="chkMDMForceDeploy" Content="Force" Foreground="#FFD700" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="Versions-Vergleich ignorieren und MSI-Content neu hochladen"/>
                            <Button x:Name="btnMDMDeployStudent" Content="Student deployen" Width="140" Margin="0,0,6,0" Background="#0A84FF" Foreground="White" ToolTip="Erstellt oder aktualisiert die Student-App in Intune"/>
                            <Button x:Name="btnMDMDeployTeacher" Content="Teacher deployen" Width="140" Margin="0,0,6,0" Background="#0A84FF" Foreground="White" ToolTip="Erstellt oder aktualisiert die Teacher-App in Intune"/>
                            <Button x:Name="btnMDMDeployBoth"    Content="Beide deployen"   Width="130" Background="#107C10" Foreground="White" ToolTip="Erstellt oder aktualisiert beide Apps in Intune"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>

<TabItem Header="GPO Setup">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*" MinHeight="80"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="2*" MinHeight="120"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <GroupBox Header="Tasks (Doppelklick oder Multi-Select, dann Aktion)" Grid.Row="0">
                        <ListView x:Name="lstGPOTasks" SelectionMode="Extended"
                                  Background="#2D2D30" Foreground="#E0E0E0" BorderBrush="#3F3F46">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Task"                 Width="180" DisplayMemberBinding="{Binding DisplayName}"/>
                                    <GridViewColumn Header="Domain"               Width="150" DisplayMemberBinding="{Binding DomainFQDN}"/>
                                    <GridViewColumn Header="Student-GPO"          Width="140" DisplayMemberBinding="{Binding StudentGPOStatus}"/>
                                    <GridViewColumn Header="Student-Link"         Width="110" DisplayMemberBinding="{Binding StudentLinkStatus}"/>
                                    <GridViewColumn Header="Teacher-GPO"          Width="140" DisplayMemberBinding="{Binding TeacherGPOStatus}"/>
                                    <GridViewColumn Header="Teacher-Link"         Width="110" DisplayMemberBinding="{Binding TeacherLinkStatus}"/>
                                    <GridViewColumn Header="Student-FW-GPO"       Width="140" DisplayMemberBinding="{Binding StudentFWStatus}"/>
                                    <GridViewColumn Header="Teacher-FW-GPO"       Width="140" DisplayMemberBinding="{Binding TeacherFWStatus}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </GroupBox>

                    <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="#3F3F46" ShowsPreview="True"/>

                    <GroupBox Header="GPO-Details fuer ausgewaehlten Task" Grid.Row="2">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <TextBox x:Name="txtGPODetail" IsReadOnly="True" AcceptsReturn="True"
                                     FontFamily="Consolas" FontSize="12"
                                     Background="#252526" Foreground="#D0D0D0" BorderThickness="0"
                                     Text="Keine Task markiert."/>
                        </ScrollViewer>
                    </GroupBox>

                    <Grid Grid.Row="3" Margin="4,6,4,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="lblGPOHint" Grid.Column="0" VerticalAlignment="Center" Foreground="#9A9A9A"
                                   Text="&apos;andere OU&apos; = GPO existiert + verknuepft, aber nicht mit der Task-OU (OUTarget). Verknuepfen setzt zusaetzlichen Link mit Task-OU."/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="btnGPORefresh"    Content="Status aktualisieren"  Width="160"/>
                            <Button x:Name="btnGPOCreate"     Content="Install-GPOs"          Width="140" Background="#0A84FF" Foreground="White"/>
                            <Button x:Name="btnGPOCreateFW"   Content="FW-GPOs"               Width="140" Background="#0A84FF" Foreground="White"/>
                            <Button x:Name="btnGPOLink"       Content="Mit OU verknuepfen"    Width="160"/>
                            <Button x:Name="btnGPOWMICleanup" Content="WMI-Filter cleanup" Width="140"
                                    ToolTip="Entfernt alle WMI-Filter mit Prefix '&lt;GPONamePrefix&gt;WMI' - falls Filter korrupt/defekt sind"/>
                            <Button x:Name="btnGPORemove"     Content="GPOs entfernen"        Width="140"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Settings">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" MinHeight="250"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Row 0: Bestehende Task-Konfiguration -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Tasks-Liste -->
                        <GroupBox Header="Tasks" Grid.Column="0">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                                    <Button x:Name="btnTaskAdd"    Content="+ Neu"    Width="70"/>
                                    <Button x:Name="btnTaskRemove" Content="Entfernen" Width="90"/>
                                </StackPanel>
                                <ListBox x:Name="lstTasks" />
                            </DockPanel>
                        </GroupBox>

                        <!-- Detail Formular -->
                        <GroupBox Header="Task-Details" Grid.Column="1">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="pnlTaskDetails" IsEnabled="False">
                                    <Label Content="Anzeigename"/>
                                    <TextBox x:Name="txtDisplayName"/>

                                    <Label Content="Domain FQDN" Margin="0,6,0,0"/>
                                    <TextBox x:Name="txtDomainFQDN"/>

                                    <Label Content="DC Server (Hostname oder IP)" Margin="0,6,0,0"/>
                                    <TextBox x:Name="txtDCServer"/>

                                    <Label Content="Student-Share (UNC)" Margin="0,6,0,0"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="txtStudentShare" Grid.Column="0"/>
                                        <Button  x:Name="btnStudentShareBrowse" Grid.Column="1" Content="..." Width="32"/>
                                    </Grid>

                                    <Label Content="Teacher-Share (UNC)" Margin="0,6,0,0"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="txtTeacherShare" Grid.Column="0"/>
                                        <Button  x:Name="btnTeacherShareBrowse" Grid.Column="1" Content="..." Width="32"/>
                                    </Grid>

                                    <Label Content="Status-Share (Client-Feedback) - UNC" Margin="0,6,0,0"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="txtStatusShare" Grid.Column="0"/>
                                        <Button  x:Name="btnStatusShareInit" Grid.Column="1" Content="Anlegen + ACL" Width="120"
                                                ToolTip="Legt den Ordner an und setzt NTFS-ACL: Domain-Computers Write, Domain-Admins Full, nur DIESER Ordner (Vererbung aus)"/>
                                    </Grid>
                                    <TextBlock Foreground="#888" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"
                                               Text="Optional. Wenn gesetzt, schreibt das Startup-Script nach jedem Install-Check eine kleine JSON-Datei hier rein. Leer lassen = kein Client-Feedback."/>

                                    <Label Content="OU-Ziel Student (DistinguishedName, z.B. OU=Workstations,DC=...)" Margin="0,6,0,0"/>
                                    <TextBox x:Name="txtOUStudent"/>

                                    <Label Content="OU-Ziel Teacher (DistinguishedName, z.B. OU=Workstations,DC=...)" Margin="0,6,0,0"/>
                                    <TextBox x:Name="txtOUTeacher"/>

                                    <Label Content="WMI-Filter Student (Typ + Muster)" Margin="0,6,0,0"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="cmbWMIStudentType" SelectedIndex="3"
                                                  Background="#2D2D30" Foreground="#E0E0E0" BorderBrush="#3F3F46">
                                            <ComboBoxItem>Prefix</ComboBoxItem>
                                            <ComboBoxItem>Pattern</ComboBoxItem>
                                            <ComboBoxItem>List</ComboBoxItem>
                                            <ComboBoxItem>Custom</ComboBoxItem>
                                        </ComboBox>
                                        <TextBox x:Name="txtWMIStudent" Grid.Column="1" Margin="4,0,0,0"/>
                                    </Grid>

                                    <Label Content="WMI-Filter Teacher (Typ + Muster)" Margin="0,6,0,0"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="cmbWMITeacherType" SelectedIndex="3"
                                                  Background="#2D2D30" Foreground="#E0E0E0" BorderBrush="#3F3F46">
                                            <ComboBoxItem>Prefix</ComboBoxItem>
                                            <ComboBoxItem>Pattern</ComboBoxItem>
                                            <ComboBoxItem>List</ComboBoxItem>
                                            <ComboBoxItem>Custom</ComboBoxItem>
                                        </ComboBox>
                                        <TextBox x:Name="txtWMITeacher" Grid.Column="1" Margin="4,0,0,0"/>
                                    </Grid>
                                    <TextBlock Foreground="#888" FontSize="11" Margin="0,4,0,0"
                                        Text="Prefix: PC-S ergibt Name LIKE 'PC-S%'. List: komma-/semikolon-getrennt. Custom: eigene WQL. Leer = kein WMI-Filter."/>

                                    <Label Content="GPO-Name-Praefix (z.B. HU-NEXT-EXAM-)" Margin="0,12,0,0"/>
                                    <TextBox x:Name="txtGPOPrefix"/>

                                    <Expander Header="Firewall-Einstellungen (fuer FW-GPOs)" Margin="0,12,0,0" Foreground="#E0E0E0">
                                        <StackPanel Margin="0,6,0,0">
                                            <Label Content="Profile (kommagetrennt: Domain, Private, Public)"/>
                                            <TextBox x:Name="txtFWProfiles"/>

                                            <Label Content="Student EXE-Pfad (fuer App-Rule)" Margin="0,6,0,0"/>
                                            <TextBox x:Name="txtFWStudentExe"/>

                                            <Label Content="Teacher EXE-Pfad (fuer App-Rule)" Margin="0,6,0,0"/>
                                            <TextBox x:Name="txtFWTeacherExe"/>

                                            <Grid Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox x:Name="chkFWTCP" Content="TCP-Port zulassen:" VerticalAlignment="Center"/>
                                                <TextBox  x:Name="txtFWTCPPort" Grid.Column="1" Margin="6,0,0,0"/>
                                            </Grid>

                                            <Grid Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox x:Name="chkFWUDP" Content="UDP-Ports zulassen (Komma):" VerticalAlignment="Center"/>
                                                <TextBox  x:Name="txtFWUDPPorts" Grid.Column="1" Margin="6,0,0,0"/>
                                            </Grid>
                                        </StackPanel>
                                    </Expander>

                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button x:Name="btnTaskSave" Content="Task speichern" Width="150" Background="#0A84FF" Foreground="White"/>
                                        <Button x:Name="btnTestConn"   Content="Verbindung testen" Width="150"/>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </GroupBox>
                    </Grid>

                    <!-- Row 1: MDM-Tenants Verwaltung -->
                    <GroupBox Header="MDM-Tenants (Intune)" Grid.Row="1" Margin="0,6,0,0">
                        <Grid Margin="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ListView x:Name="lstMDMTenants" Grid.Column="0" Height="100" Background="#2D2D30" Foreground="#E0E0E0" BorderBrush="#3F3F46">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Name" Width="160" DisplayMemberBinding="{Binding TenantName}"/>
                                        <GridViewColumn Header="Tenant-ID" Width="300" DisplayMemberBinding="{Binding TenantId}"/>
                                        <GridViewColumn Header="Client-ID" Width="300" DisplayMemberBinding="{Binding ClientId}"/>
                                        <GridViewColumn Header="Credentials" Width="90" DisplayMemberBinding="{Binding CredStatus}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>

                            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Top">
                                <Button x:Name="btnMDMTenantAdd"    Content="+ Hinzufuegen" Width="120" Margin="0,0,0,4"/>
                                <Button x:Name="btnMDMTenantEdit"   Content="Bearbeiten"    Width="120" Margin="0,0,0,4"/>
                                <Button x:Name="btnMDMTenantRemove" Content="Entfernen"     Width="120" Margin="0,0,0,4"/>
                                <Button x:Name="btnMDMTenantSaveCred" Content="Secret speichern" Width="120" Margin="0,8,0,0" ToolTip="Client-Secret DPAPI-verschluesselt speichern"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="Log-Viewer">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Label Content="Level:" Grid.Column="0" VerticalAlignment="Center"/>
                        <ComboBox x:Name="cmbLogLevel" Grid.Column="1" Width="120" VerticalAlignment="Center" SelectedIndex="0"
                                  Background="#2D2D30" Foreground="#E0E0E0" BorderBrush="#3F3F46">
                            <ComboBoxItem>ALL</ComboBoxItem>
                            <ComboBoxItem>DEBUG</ComboBoxItem>
                            <ComboBoxItem>INFO</ComboBoxItem>
                            <ComboBoxItem>WARN</ComboBoxItem>
                            <ComboBoxItem>ERROR</ComboBoxItem>
                        </ComboBox>
                        <Label Content="Suche:" Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtLogSearch" Grid.Column="3" Width="220" VerticalAlignment="Center"/>
                        <TextBlock x:Name="lblLogFile" Grid.Column="4" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#9A9A9A" TextTrimming="CharacterEllipsis"/>
                        <Button x:Name="btnLogRefresh" Grid.Column="5" Content="Aktualisieren" Width="110"/>
                        <Button x:Name="btnLogOpenDir" Grid.Column="6" Content="Ordner oeffnen" Width="120"/>
                        <Button x:Name="btnLogClear"   Grid.Column="7" Content="Log loeschen" Width="110"/>
                    </Grid>

                    <TextBox x:Name="txtLogContent" Grid.Row="1" IsReadOnly="True"
                             FontFamily="Consolas" FontSize="11"
                             AcceptsReturn="True" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             Background="#1E1E1E" Foreground="#D0D0D0" BorderBrush="#3F3F46"/>
                </Grid>
            </TabItem>
        </TabControl>
        </DockPanel>

        <!-- Loading-Overlay -->
        <Border x:Name="overlayLoading" Background="#D0000000" Visibility="Visible"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Initialisierung..." FontSize="28" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                <ProgressBar IsIndeterminate="True" Width="360" Height="8" Margin="0,16,0,12" Foreground="#0A84FF" Background="#2D2D30"/>
                <TextBlock x:Name="lblLoadingStatus" Text="Bereit..." Foreground="#E0E0E0" FontSize="14" HorizontalAlignment="Center"/>
                <TextBlock Text="Je nach Netzwerk/AD kann das bis ca. 40 Sekunden dauern." Foreground="#888" FontSize="11" Margin="0,20,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
